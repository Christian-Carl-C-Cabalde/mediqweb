<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug build: allow cleartext to local Ktor server addresses so the
  emulator/device can reach http://10.0.2.2:8099/ via adb reverse.
  Production host and Supabase still require HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">mediq-ktor-server.onrender.com</domain>
        <domain includeSubdomains="false">wdoyhtjpjhmhsegdllvd.supabase.co</domain>
    </domain-config>
</network-security-config>
