{
  "buildCommand": "npm run build && ./vercel-build.sh",
  "installCommand": "npm ci",
  "outputDirectory": "dist/mediqapp-fe",
  "routes": [
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/(.+\\..+)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
